# NUTC Portal production environment — direct Cloudflare proxy, no Tunnel.
# Copy to /etc/eportal-bot/eportal.env (or another protected location).

# Node must not be exposed directly. Caddy/nginx is the only public listener.
HOST=127.0.0.1
PORT=4174

# Enforce Cloudflare Access again at the Node origin.
CLOUDFLARE_ACCESS_ENFORCE=1
CLOUDFLARE_ACCESS_TEAM_DOMAIN=https://YOUR-TEAM.cloudflareaccess.com
CLOUDFLARE_ACCESS_AUD=YOUR_APPLICATION_AUD_TAG

# When systemd supervises the process, let the Debug restart action exit and
# allow systemd to bring it back up.
EPORTAL_RESTART_MODE=exit

# Optional:
# EPORTAL_KEEPALIVE_MINUTES=10
# EPORTAL_LOGIN_BRIDGE_TTL_MINUTES=15
